/training_logs/
/wandb_logs/
wandb/

# Notebook outputs (but track the .ipynb files themselves)
.ipynb_checkpoints/
notebooks/lightning_logs/
notebooks/**/*.png
notebooks/**/*.jpg

# Python build artifacts
__pycache__/
*.pyc
*.egg-info/

# Editor
.vscode/
.DS_Store

# Claude Code local state (settings, worktrees) -- never shared
.claude/

# SLURM logs
slurm/logs/
*.out

